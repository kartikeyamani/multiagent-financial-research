# ── Required ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional ───────────────────────────────────────────────────────────────────
# FastAPI server host/port
API_HOST=0.0.0.0
API_PORT=8000

# FAISS index path (auto-created on first run)
FAISS_INDEX_PATH=./faiss_index

# SQLite database path
DB_PATH=./runs.db
